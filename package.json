{
  "name": "opensoc-studio",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test tests/contract/*.test.mjs tests/licensing/*.test.mjs",
    "check": "node infra/scripts/check.mjs",
    "doctor": "node infra/scripts/doctor.mjs",
    "audit:upstreams": "node infra/scripts/audit-upstreams.mjs",
    "audit:licenses": "node infra/scripts/license-audit.mjs",
    "spike:a": "node infra/scripts/spike-preflight.mjs A",
    "spike:b": "node infra/scripts/spike-preflight.mjs B",
    "release:gate": "node infra/scripts/license-audit.mjs --release",
    "dev": "node infra/scripts/dev.mjs",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:web": "tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "test:api": "node infra/scripts/python.mjs -m pytest tests/integration -q",
    "test:e2e": "playwright test",
    "start": "node infra/scripts/python.mjs -m uvicorn apps.api.main:app --host 127.0.0.1 --port 8000",
    "sim:reference": "node infra/scripts/python.mjs -m workers.reference_soc.runner",
    "runtime:setup": "node infra/scripts/setup-runtime.mjs",
    "runtime:verify": "node infra/scripts/python.mjs infra/scripts/runtime-acceptance.py --negative",
    "verify": "node infra/scripts/verify.mjs",
    "export:contracts": "node infra/scripts/python.mjs infra/scripts/export-contracts.py && prettier --write apps/web/src/api-contracts.ts",
    "format:check": "prettier --check apps/web/src apps/web/vite.config.ts tests/browser-e2e playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "ajv": "8.20.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "dockview-react": "8.6.1",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "dompurify": "3.4.16"
  }
}
